# ==============================================================
# AI-Powered Real Estate Decision Intelligence System (.env.example)
# ==============================================================

PROJECT_NAME="AI-Powered Real Estate Decision Intelligence System"
API_V1_STR="/api"
SECRET_KEY="your-super-secret-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite default; PostgreSQL on Render)
DATABASE_URL="sqlite:///./real_estate_bi.db"

# LLM Providers
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEFAULT_LLM_PROVIDER="gemini"

# Server Port
PORT=8000
